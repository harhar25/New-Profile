# Copy to .env.local for local development, or set these in your hosting dashboard.
# Keep the real key server-only. Never use a NEXT_PUBLIC_ prefix for a secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Set true only if your hosting proxy replaces client-supplied X-Forwarded-For,
# X-Forwarded-Host, and X-Forwarded-Proto.
# Otherwise all visitors share the per-process anonymous rate limit.
ASSISTANT_TRUST_PROXY=false
